{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAC",
  "version": "0.1.0",
  "identifier": "online.cdor.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MAC",
        "width": 960,
        "height": 720,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["mac"],
          "appLink": false
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
