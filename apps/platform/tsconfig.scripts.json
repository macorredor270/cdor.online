  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    ".svelte-kit/ambient.d.ts",
    "drizzle.config.ts",
