{
  "name": "@cdor/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.scripts.json --noEmit",
    "test": "svelte-kit sync && vitest run tests/validation tests/ai/model-catalog.test.ts tests/ai/output-filter.test.ts tests/backend/http.test.ts tests/backend/security.test.ts tests/backend/account.test.ts tests/sse/chat-stream.test.ts",
    "test:security": "svelte-kit sync && vitest run tests/backend/security.test.ts tests/validation/server-environment.test.ts",
    "test:validation": "svelte-kit sync && vitest run tests/validation",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts && node scripts/db/verify-migrations.mjs",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:migrate:test": "vitest run tests/db/migrations.test.ts",
    "test:db": "vitest run tests/db",
    "test:backend": "svelte-kit sync && vitest run tests/backend",
    "test:auth": "svelte-kit sync && vitest run tests/auth",
    "test:ai": "svelte-kit sync && vitest run tests/ai",
    "test:sse": "svelte-kit sync && vitest run tests/sse",
    "test:sync": "svelte-kit sync && vitest run tests/sync",
    "test:web": "svelte-kit sync && vitest run tests/web",
    "test:e2e:web": "vite build && ../../scripts/web/smoke-e2e.sh",
    "test:idempotency": "svelte-kit sync && vitest run tests/sync/idempotency.integration.test.ts",
    "test:repositories": "svelte-kit sync && vitest run tests/backend/services.integration.test.ts",
    "smoke:health": "../../scripts/backend/smoke-health.sh",
    "smoke:smtp": "node --import tsx scripts/auth/smoke-smtp.ts",
    "benchmark:nvidia": "node --import tsx scripts/ai/benchmark-nvidia.ts",
    "smoke:nvidia": "node --import tsx scripts/ai/smoke-nvidia.ts",
    "smoke:openrouter": "node --import tsx scripts/ai/smoke-openrouter.ts",
    "maintenance:generations": "node --import tsx scripts/stream/reconcile-generations.ts",
    "maintenance:sync": "node --import tsx scripts/sync/maintenance.ts",
    "smoke:stream:hostinger": "node --import tsx scripts/stream/smoke-hostinger.ts",
    "smoke:stream:real:hostinger": "node --import tsx scripts/stream/smoke-real-hostinger.ts",
    "db:explain": "tsx scripts/db/explain.ts",
    "db:verify-schema": "tsx scripts/db/verify-schema.ts",
    "db:remove-test-accounts": "tsx scripts/db/remove-test-accounts.ts"
  },
  "dependencies": {
    "@cdor/contracts": "workspace:*",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "mysql2": "3.22.6",
    "nodemailer": "9.0.3",
    "ulid": "3.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@shikijs/langs": "4.3.1",
    "@shikijs/themes": "4.3.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "drizzle-kit": "0.31.10",
    "shiki": "4.3.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
