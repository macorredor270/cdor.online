NODE_ENV=development
ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173/api/v1

# Solo servidor. No usar el prefijo PUBLIC_ para secretos.
DB_HOST=
DB_PORT=3306
DB_POOL_LIMIT=3
DB_NAME=
DB_USER=
DB_PASSWORD=
# Solo scripts de migración/administración. El runtime construye la conexión
# con DB_* para evitar que una URL remota invalide el localhost de Hostinger.
DATABASE_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
AUTH_SIGN_UP_ENABLED=true

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=no-reply@cdor.online

# ── IA de MAC ─────────────────────────────────────────────────────────────
# MAC es gratuito y se presenta como un único modelo propio. Detrás reparte las
# conversaciones entre los proveedores gratuitos cuya clave definas, con respaldo
# automático. Basta UNA clave. Ver docs/ai.md. Los niveles gratuitos pueden
# registrar o usar los prompts: activa solo los proveedores que aceptes.
#
# <ID>_DEFAULT_MODEL fija el modelo (por defecto se descubre en el catálogo del
# proveedor); <ID>_RPM ajusta el cupo de peticiones por minuto.

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=
NVIDIA_REQUEST_TIMEOUT_MS=120000
NVIDIA_RPM=

GROQ_API_KEY=
GROQ_DEFAULT_MODEL=
GROQ_RPM=

GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=
GEMINI_RPM=

MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=
MISTRAL_RPM=

# Orden de preferencia (los no listados van detrás) y reparto: ordered | weighted.
AI_PROVIDER_ORDER=
AI_ROUTING=ordered

# Tus propios proveedores compatibles con OpenAI (Ollama, vLLM, Cloudflare
# Workers AI…), sin tocar código. Lista JSON, entre comillas simples:
# AI_CUSTOM_PROVIDERS='[{"id":"ollama","baseUrl":"http://127.0.0.1:11434/v1","model":"llama3.3"}]'
AI_CUSTOM_PROVIDERS=

# OpenRouter: su router gratuito como proveedor de chat (opt-in: los modelos
# gratuitos pueden registrar los prompts) y la herramienta de búsqueda web.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_REQUEST_TIMEOUT_MS=120000
AI_FALLBACK_OPENROUTER=false
# La búsqueda web usa una herramienta de pago de OpenRouter: desactivada.
AI_WEB_SEARCH=false

# Cuotas diarias (día UTC). 0 desactiva el límite. Reparten de forma justa los
# cupos gratuitos de los proveedores; el global evita que un pico los agote.
QUOTA_USER_DAILY_MESSAGES=100
QUOTA_USER_DAILY_TOKENS=150000
QUOTA_GLOBAL_DAILY_TOKENS=0


# OAuth social. Ambos proveedores son obligatorios en el release público.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Solo para la canary técnica de M7; mínimo 32 caracteres aleatorios.
STREAM_CANARY_TOKEN=
STREAM_CANARY_URL=https://cdor.online/api/v1/internal/stream-canary
