{
  "name": "cdor",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "11.3.0"
  },
  "scripts": {
    "dev": "pnpm dev:local",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:platform": "pnpm --dir apps/platform dev",
    "build:platform": "pnpm --dir apps/platform build",
    "start:platform": "pnpm --dir apps/platform start",
    "dev:mobile": "pnpm --dir apps/mobile dev",
    "build:mobile": "pnpm --dir apps/mobile build",
    "tauri": "pnpm --dir apps/mobile tauri",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "test:validation": "pnpm --filter @cdor/contracts test:validation && pnpm --filter @cdor/platform test:validation && node --test scripts/client-secret-scan.test.mjs",
    "scan:client-secrets": "node scripts/scan-client-secrets.mjs",
    "db:local:up": "./scripts/db/local-up.sh",
    "db:generate": "pnpm --dir apps/platform db:generate",
    "db:check": "pnpm --dir apps/platform db:check",
    "db:migrate": "pnpm --dir apps/platform db:migrate",
    "db:migrate:test": "./scripts/db/run-test-command.sh db:migrate:test",
    "test:db": "./scripts/db/run-test-command.sh test:db",
    "test:backend": "./scripts/db/run-test-command.sh test:backend",
    "test:auth": "./scripts/db/run-test-command.sh test:auth",
    "test:ai": "pnpm --dir apps/platform test:ai",
    "test:sse": "./scripts/db/run-test-command.sh test:sse",
    "test:sync": "./scripts/db/run-test-command.sh test:sync",
    "test:web": "pnpm --dir apps/platform test:web",
    "test:e2e:web": "pnpm --dir apps/platform test:e2e:web",
    "test:idempotency": "./scripts/db/run-test-command.sh test:idempotency",
    "test:repositories": "./scripts/db/run-test-command.sh test:repositories",
    "smoke:health": "./scripts/backend/smoke-health.sh",
    "smoke:smtp": "pnpm --dir apps/platform smoke:smtp",
    "benchmark:nvidia": "pnpm --dir apps/platform benchmark:nvidia",
    "smoke:nvidia": "pnpm --dir apps/platform smoke:nvidia",
    "smoke:openrouter": "pnpm --dir apps/platform smoke:openrouter",
    "smoke:providers": "pnpm --dir apps/platform smoke:providers",
    "maintenance:generations": "pnpm --dir apps/platform maintenance:generations",
    "maintenance:sync": "pnpm --dir apps/platform maintenance:sync",
    "smoke:stream:hostinger": "pnpm --dir apps/platform smoke:stream:hostinger",
    "smoke:stream:real:hostinger": "pnpm --dir apps/platform smoke:stream:real:hostinger",
    "db:compat:test": "./scripts/db/run-test-command.sh test:db mysql && ./scripts/db/run-test-command.sh test:db mariadb",
    "db:explain": "./scripts/db/run-test-command.sh db:explain",
    "db:backup": "./scripts/db/backup-local.sh",
    "db:restore:test": "./scripts/db/restore-test.sh",
    "hostinger:build": "pnpm build:platform",
    "build:hostinger": "./scripts/hostinger/build-runtime.sh",
    "hostinger:start": "pnpm start:platform",
    "production:preflight": "./scripts/production/preflight.sh",
    "production:smoke": "./scripts/production/smoke.sh",
    "production:load": "node scripts/load/http-smoke.mjs",
    "security:audit": "pnpm audit --prod --audit-level high",
    "db:verify-schema": "pnpm --dir apps/platform db:verify-schema",
    "db:remove-test-accounts": "pnpm --dir apps/platform db:remove-test-accounts"
  }
}
